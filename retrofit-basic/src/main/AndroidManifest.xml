<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Network">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".BreedsActivity"
            android:exported="false"
            android:label="@string/screen_breeds" />
        <activity
            android:name=".PostsActivity"
            android:exported="false"
            android:label="@string/screen_posts" />
        <activity
            android:name=".MistakesActivity"
            android:exported="false"
            android:label="@string/screen_mistakes" />
    </application>

</manifest>
